{
  "name": "abako",
  "version": "1.0.0",
  "description": "Desktop app for running a math competition: generates exams and answer keys from an Excel question bank, grades entries, and produces per-student PDF reports.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "python build_sidecar.py && electron-builder --win portable"
  },
  "keywords": [
    "electron",
    "flask",
    "pdf",
    "reportlab",
    "education",
    "exams"
  ],
  "author": "Raaif Yousuf",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^3.4.0"
  },
  "build": {
    "appId": "com.abakotech.acs",
    "productName": "Abako Competition Suite",
    "win": {
      "target": "portable"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "dist/",
      "src/"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Raaif-Yousuf/Abako.git"
  }
}
